# SORTOLOG IQ — Environment Configuration Template

# Application Environment & URLs
APP_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Primary AI Provider: IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Secondary AI Provider: Google Gemini API (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI Session Limits & Budgeting
MAX_AI_REQUESTS_PER_SESSION=500
MAX_AI_TOKENS_PER_SESSION=200000

# IBM Cloud Object Storage Credentials (Backend Only - Optional)
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_API_KEY=your_ibm_cos_api_key
IBM_COS_INSTANCE_ID=your_ibm_cos_instance_crn
IBM_COS_BUCKET=sortolog-iq-bucket

# Session Management
SESSION_TIMEOUT_MINUTES=60

